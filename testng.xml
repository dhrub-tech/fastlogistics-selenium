<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="FastLogistics Automation Suite" verbose="2" parallel="false" preserve-order="true">

    <!-- Smoke Test Suite: Fast checks for critical functionality -->
    <test name="Smoke Tests">
        <classes>
            <class name="tests.LoginTest" />
            <class name="tests.DashboardTest" />
        </classes>
    </test>

    <!-- Functional & Feature Tests -->
    <test name="Shipment Module Tests">
        <classes>
            <class name="tests.CreateShipmentTest" />
            <class name="tests.CreateShipmentValidationTest" />
            <class name="tests.SearchShipmentTest" />
            <class name="tests.UpdateStatusTest" />
        </classes>
    </test>

    <!-- End-To-End Workflows -->
    <test name="E2E Regression Tests">
        <classes>
            <class name="tests.EndToEndTest" />
        </classes>
    </test>

</suite>